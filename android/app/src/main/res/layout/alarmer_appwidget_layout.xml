<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Header Bar with Check All Action -->
    <LinearLayout
        android:id="@+id/widget_header_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="6dp">

        <ImageView
            android:id="@+id/widget_logo_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@mipmap/ic_launcher" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_header_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Alarmer Live"
                android:textColor="#F9FAFB"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Active Alerts"
                android:textColor="#9CA3AF"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- Check All Action Button in Header -->
        <TextView
            android:id="@+id/widget_refresh_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_live_pill"
            android:paddingLeft="8dp"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingRight="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="⟳ Check All"
            android:textColor="#10B981"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/widget_divider_1"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="5dp"
        android:background="#21262D" />

    <!-- List of Clean Single-Line Alert Cards -->
    <LinearLayout
        android:id="@+id/widget_items_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <!-- Item 1 Card (Single Line: Symbol | Price | Pct) -->
        <LinearLayout
            android:id="@+id/item_1_root"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:background="@drawable/widget_row_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="8dp"
            android:paddingStart="8dp"
            android:paddingTop="5dp"
            android:paddingRight="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="5dp"
            android:visibility="visible">

            <TextView
                android:id="@+id/item_1_symbol"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BTC/USDT"
                android:textColor="#F9FAFB"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/item_1_price"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="$87,420.00"
                android:textColor="#F59E0B"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/item_1_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_green"
                android:paddingLeft="5dp"
                android:paddingStart="5dp"
                android:paddingTop="2dp"
                android:paddingRight="5dp"
                android:paddingEnd="5dp"
                android:paddingBottom="2dp"
                android:text="+2.50% ▲"
                android:textColor="#3FB950"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Item 2 Card -->
        <LinearLayout
            android:id="@+id/item_2_root"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:background="@drawable/widget_row_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="8dp"
            android:paddingStart="8dp"
            android:paddingTop="5dp"
            android:paddingRight="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="5dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/item_2_symbol"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ETH/USDT"
                android:textColor="#F9FAFB"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/item_2_price"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="$3,150.00"
                android:textColor="#F59E0B"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/item_2_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_red"
                android:paddingLeft="5dp"
                android:paddingStart="5dp"
                android:paddingTop="2dp"
                android:paddingRight="5dp"
                android:paddingEnd="5dp"
                android:paddingBottom="2dp"
                android:text="-1.20% ▼"
                android:textColor="#F85149"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Item 3 Card -->
        <LinearLayout
            android:id="@+id/item_3_root"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:background="@drawable/widget_row_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="8dp"
            android:paddingStart="8dp"
            android:paddingTop="5dp"
            android:paddingRight="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="5dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/item_3_symbol"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SOL/USDT"
                android:textColor="#F9FAFB"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/item_3_price"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="$185.20"
                android:textColor="#F59E0B"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/item_3_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_done"
                android:paddingLeft="5dp"
                android:paddingStart="5dp"
                android:paddingTop="2dp"
                android:paddingRight="5dp"
                android:paddingEnd="5dp"
                android:paddingBottom="2dp"
                android:text="✔️ Done"
                android:textColor="#E3B341"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Empty state -->
        <TextView
            android:id="@+id/widget_empty_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="No active alerts configured"
            android:textColor="#9CA3AF"
            android:textSize="10sp"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/widget_divider_2"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="2dp"
        android:background="#21262D" />

    <!-- Footer -->
    <TextView
        android:id="@+id/widget_footer_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center"
        android:text="Tap to open Alarmer"
        android:textColor="#10B981"
        android:textSize="8.5sp" />
</LinearLayout>
