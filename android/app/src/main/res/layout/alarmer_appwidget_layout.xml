<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header Bar matching in-app widget preview -->
    <LinearLayout
        android:id="@+id/widget_header_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/widget_logo_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@mipmap/ic_launcher" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_header_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Alarmer Live Widget"
                android:textColor="#F9FAFB"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Real-time Active Alerts"
                android:textColor="#9CA3AF"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- LIVE Badge Pill -->
        <TextView
            android:id="@+id/widget_active_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_live_pill"
            android:paddingLeft="8dp"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingRight="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="⚡ LIVE"
            android:textColor="#10B981"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/widget_divider_1"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="8dp"
        android:background="#21262D" />

    <!-- List of Clean Alert Cards -->
    <LinearLayout
        android:id="@+id/widget_items_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <!-- Item 1 Card -->
        <LinearLayout
            android:id="@+id/item_1_root"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:background="@drawable/widget_row_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="10dp"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingRight="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp"
            android:visibility="visible">

            <TextView
                android:id="@+id/item_1_symbol"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BTC/USDT"
                android:textColor="#F9FAFB"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/item_1_price"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="$87,420.00"
                android:textColor="#F59E0B"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/item_1_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_green"
                android:paddingLeft="7dp"
                android:paddingStart="7dp"
                android:paddingTop="3dp"
                android:paddingRight="7dp"
                android:paddingEnd="7dp"
                android:paddingBottom="3dp"
                android:text="≥ $90,000"
                android:textColor="#3FB950"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Item 2 Card -->
        <LinearLayout
            android:id="@+id/item_2_root"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:background="@drawable/widget_row_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="10dp"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingRight="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/item_2_symbol"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ETH/USDT"
                android:textColor="#F9FAFB"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/item_2_price"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="$3,150.00"
                android:textColor="#F59E0B"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/item_2_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_red"
                android:paddingLeft="7dp"
                android:paddingStart="7dp"
                android:paddingTop="3dp"
                android:paddingRight="7dp"
                android:paddingEnd="7dp"
                android:paddingBottom="3dp"
                android:text="≤ $3,000"
                android:textColor="#F85149"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Item 3 Card -->
        <LinearLayout
            android:id="@+id/item_3_root"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:background="@drawable/widget_row_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="10dp"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingRight="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/item_3_symbol"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SOL/USDT"
                android:textColor="#F9FAFB"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/item_3_price"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="$185.20"
                android:textColor="#F59E0B"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/item_3_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_done"
                android:paddingLeft="7dp"
                android:paddingStart="7dp"
                android:paddingTop="3dp"
                android:paddingRight="7dp"
                android:paddingEnd="7dp"
                android:paddingBottom="3dp"
                android:text="✔️ Done"
                android:textColor="#E3B341"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Empty state -->
        <TextView
            android:id="@+id/widget_empty_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:text="No active alerts configured"
            android:textColor="#9CA3AF"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/widget_divider_2"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:background="#21262D" />

    <!-- Footer -->
    <TextView
        android:id="@+id/widget_footer_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="Tap to open Alarmer"
        android:textColor="#10B981"
        android:textSize="9sp" />
</LinearLayout>
